SOURCE_LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_RATE_PER_IP_HOUR=30
LLM_RATE_GLOBAL_DAY=800
# CIDR ranges of reverse proxies whose X-Real-IP / X-Forwarded-For are trusted;
# empty (default) ignores forwarded headers and uses the socket peer address.
TRUSTED_PROXIES=
# Max Gemini calls in flight; extra requests degrade instead of queueing.
LLM_PROVIDER_MAX_CONCURRENCY=4
